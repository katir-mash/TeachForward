# Copy to server/.env and add your key locally. Never paste it into chat or Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
PORT=3001

# At most one SDK retry for transient failures, within the 20-second total deadline.
# Set to 0 for a strictly single-attempt live check.
OPENAI_MAX_RETRIES=1

# Production: set the exact public origin (HTTPS, no trailing slash).
# APP_ORIGIN=https://your-teachforward-domain.example
# A stable random secret (32+ characters) is required for AI/admin and production.
# Never commit the real value.
# SESSION_SECRET=
# Set only when deployed behind exactly one trusted reverse proxy.
# TRUST_PROXY=1

# Run npm.cmd run setup:admin locally to generate a password hash and stable
# signing secret without printing credentials. Never put these in VITE_ values.
# ADMIN_PASSWORD_HASH=

# Optional durable access-store path inside the project (single Node process).
# ACCESS_DATA_FILE=server/data/access.json

# Persistent AI daily budgets. These count all possible upstream attempts,
# including an optional retry. Global/network attempt slots are never refunded.
AI_DAILY_REQUEST_LIMIT=100
AI_IP_DAILY_REQUEST_LIMIT=30
# USAGE_DATA_FILE=server/data/usage.json

# New Access ID creation limits; known, active browsers do not consume them.
ACCESS_ID_MAX_RECORDS=10000
ACCESS_ID_IDLE_DAYS=30
ACCESS_ID_IP_BURST_LIMIT=5
ACCESS_ID_IP_DAILY_LIMIT=40
ACCESS_ID_GLOBAL_HOURLY_LIMIT=100
ACCESS_ID_GLOBAL_DAILY_LIMIT=1000

# Public production requires APP_ORIGIN, a stable SESSION_SECRET, an actual
# persistent disk, and both settings below. A local file is not durable hosting.
# Mount the disk at this directory in Render before acknowledging it.
# DATA_DIRECTORY=/opt/render/project/src/server/data
# PERSISTENT_STORAGE_CONFIRMED=1
