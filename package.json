{
  "name": "teachforward",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A source-backed Texas teaching career navigator",
  "engines": {
    "node": ">=22.12.0 <27"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js --production",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build",
    "setup:admin": "node scripts/setup-admin.mjs"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.73.0",
    "openai": "^7.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
